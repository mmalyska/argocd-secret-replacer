// For format details, see https://aka.ms/devcontainer.json.
// The shared dev-workstation image (built in mmalyska/containers) provides the general tools, age included.
// Tools only this repository needs come from features: the .NET SDK and sops.
{
	"name": "C# (.NET)",
	"image": "ghcr.io/mmalyska/dev-workstation:1.0.0@sha256:0493a2f2b3da7f7a3bea67d210b59f9447575c07e50e4d8621abc87f3d0cb332",

	"features": {
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "10.0"
		},
		"ghcr.io/devcontainers-extra/features/sops:1": {}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"Anthropic.claude-code"
			]
		}
	},

	"postCreateCommand": "mkdir -p /home/vscode/.claude/projects/-workspaces-argocd-secret-replacer && ln -sfn /workspaces/argocd-secret-replacer/.claude/memory /home/vscode/.claude/projects/-workspaces-argocd-secret-replacer/memory"
}
